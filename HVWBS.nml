// Item
item(FEAT_ROADVEHS, item_MB_Citaro2_le_a_CC2) {
    property {
        name:                          string(STR_MB_Citaro2_le_a_CC2_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2013,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 33;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    80 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         260 kW;
        weight:                        12 ton;
        cargo_capacity:                106;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_MB_Citaro2_le_a_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_MB_Citaro2_le_a_CC2) {
    property {
         badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/suburb"];
    }
  }
}
item(FEAT_ROADVEHS, item_MB_Citaro2_le_a_CC2) {
    graphics {
        default:                       sw_MB_Citaro2_le_a_CC2;
        
        purchase:                      ss_MB_Citaro2_le_a_CC2_purchase;
        articulated_part:             sw_MB_Citaro2_le_a_CC2_articulated;
        length:                       sw_MB_Citaro2_le_a_CC2_length;
        cost_factor:                  26 * parapuco;
        running_cost_factor:          40 * pararuco;
        additional_text:              string(STR_MB_Citaro2_le_a_CC2_DATA);
        name:                         sw_MB_Citaro2_le_a_CC2_texts;
    }
}

