// Item
item(FEAT_ROADVEHS, item_MAN_LC3_18_a_CC1) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_MAN), string(STR_T1_LION_S_CITY), string(STR_S1_3), string(STR_S2_18C));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2017,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       56;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               80 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               265 kW;
		weight:              17 ton;
		cargo_capacity:      171;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
		// variant_group:             item_MAN_LC3_18_a_CC1;
	}
	graphics {
		default:             sw_MAN_LC3_18_a_CC1;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_MAN_LC3_18_a_CC1_purchase;
		articulated_part:    sw_MAN_LC3_18_a_CC1_articulated;
		length:              sw_MAN_LC3_18_a_CC1_length;
		cost_factor:         31 * parapuco;
		running_cost_factor: 43 * pararuco;
		additional_text:     string(STR_GEN_DATA, 56, string(STR_S2_18C), string(STR_O2_18M), string(STR_O1_4_DOORS));
		name:                sw_MAN_LC3_18_a_CC1_texts; // Vásárlási almenü switch
	}
}
// Csukló item
