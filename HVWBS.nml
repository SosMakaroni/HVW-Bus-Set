// Item
item(FEAT_ROADVEHS, item_MB_Conecto2_c_a_CC2) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CONECTO), string(STR_S1_2), string(STR_EMPTY));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2007,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       42;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               75 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               210 kW;
		weight:              11 ton;
		cargo_capacity:      101;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
		variant_group:             item_MB_Conecto2_c_a_CC1;
	}
	graphics {
		default:             sw_MB_Conecto2_c_a_CC2;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_MB_Conecto2_c_a_CC2_purchase;
		articulated_part:    sw_MB_Conecto2_c_a_CC2_articulated;
		length:              sw_MB_Conecto2_c_a_CC2_length;
		cost_factor:         23 * parapuco;
		running_cost_factor: 33 * pararuco;
		additional_text:     string(STR_GEN_DATA, 42, string(STR_EMPTY), string(STR_O2_12M), string(STR_O1_3_DOORS));
		name:                sw_MB_Conecto2_c_a_CC2_texts; // Vásárlási almenü switch
	}
}
