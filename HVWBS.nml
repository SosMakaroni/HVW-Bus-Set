spriteset(ss_MB_Citaro2_c_a_CC2_purchase, "src/MB/Citaro2/MB_Citaro2_c_a_CC2_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_MB_Citaro2_c_a_CC2, "src/MB/Citaro2/MB_Citaro2_c_a_CC2_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_MB_Citaro2_c_a_CC2, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_c_a_CC2_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_MB_Citaro2_c_a_CC2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_c_a_CC2_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_a_CC2, position_in_consist ) {
	1: ss_MB_Citaro2_c_a_CC2;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_a_CC2_articulated, extra_callback_info1) {
	0: item_MB_Citaro2_c_a_CC2;
	1: item_MB_Citaro2_c_a_CC2_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_a_CC2_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_a_CC2_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_MB_Citaro2_c_a_CC2_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_a_CC2_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_MB_Citaro2_c_a_CC2_INFO); // Jármű infóban név
	0x20: sw_MB_Citaro2_c_a_CC2_names; // Vásárlási lista név
	0x21: return string(STR_MB_Citaro2_c_a_CC2_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

