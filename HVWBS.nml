// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_a_CC2_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_GEN_LIVERY, string(STR_LIV_CC2)); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_a_CC2_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_GEN_INFO, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_O1_4_DOORS)); // Jármű infóban név (Gyártó-Típus-Ajtó)
	0x20: sw_MB_Citaro2_g_a_CC2_names; // Vásárlási lista név
	0x21: return string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_S1_C2), string(STR_S2_G)); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MB_Citaro2_g_a_CC2) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_S1_C2), string(STR_S2_G));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2012,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       56;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               80 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               260 kW;
		weight:              18 ton;
		cargo_capacity:      163;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
		variant_group:             item_MB_Citaro2_g_a_CC1;
	}
	graphics {
		default:             sw_MB_Citaro2_g_a_CC2;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_MB_Citaro2_g_a_CC2_purchase;
		articulated_part:    sw_MB_Citaro2_g_a_CC2_articulated;
		length:              sw_MB_Citaro2_g_a_CC2_length;
		cost_factor:         31 * parapuco;
		running_cost_factor: 42 * pararuco;
		additional_text:     string(STR_GEN_DATA, 56, string(STR_S2_G), string(STR_O2_18M), string(STR_O1_4_DOORS));
		name:                sw_MB_Citaro2_g_a_CC2_texts; // Vásárlási almenü switch
	}
}
// Csukló item
item(FEAT_ROADVEHS, item_MB_Citaro2_g_a_CC2_t) {
	property {
		name:							string(STR_BUG);
		climates_available:			bitmask(NO_CLIMATE);
		introduction_date:				date(4999999,01,01);
		cargo_allow_refit:				[PASS,TOUR];
		loading_speed:					0;
		cost_factor:					0;
		running_cost_factor:			0;
		sprite_id:						SPRITE_ID_NEW_ROADVEH;
		misc_flags:					bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:					0;
		running_cost_base:				RUNNING_COST_NONE;
		power:							0 kW;
		weight:						0 ton;
		cargo_capacity:				0;
		cargo_age_period:				0;
	}
	graphics {
		default:						sw_MB_Citaro2_g_a_CC2;
		 // Cégszín deaktiválás, ha valós színű jármű
		length:						sw_MB_Citaro2_g_a_CC2_length;
	}
}
