	1: ss_Ikarus256_a_Volan1;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Ikarus256_a_Volan1_articulated, extra_callback_info1) {
	0: item_Ikarus256_a_Volan1;
	1: item_Ikarus256_a_Volan1_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Ikarus256_a_Volan1_length, position_in_consist) {
	1: return 8;
    return 4;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Ikarus256_a_Volan1_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Ikarus256_a_Volan1_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Ikarus256_a_Volan1_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Ikarus256_a_Volan1_INFO); // Jármű infóban név
	0x20: sw_Ikarus256_a_Volan1_names; // Vásárlási lista név
	0x21: return string(STR_Ikarus256_a_Volan1_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Ikarus256_a_Volan1) {
    property {
        name:                          string(STR_Ikarus256_a_Volan1_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(1971,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 10;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    102 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         180 kW;
        weight:                        9 ton;
        cargo_capacity:                98;
        cargo_age_period:              150;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_Ikarus256_a_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_Ikarus256_a_Volan1) {
    property {
         badges:                        ["type/bus", "power/diesel", "flag/HU", "usage/intercity"];
    }
  }
}
item(FEAT_ROADVEHS, item_Ikarus256_a_Volan1) {
    graphics {
        default:                       sw_Ikarus256_a_Volan1;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_Ikarus256_a_Volan1_purchase;
        articulated_part:             sw_Ikarus256_a_Volan1_articulated;
        length:                       sw_Ikarus256_a_Volan1_length;
        cost_factor:                  17 * parapuco;
        running_cost_factor:          27 * pararuco;
        additional_text:              string(STR_Ikarus256_a_Volan1_DATA);
        name:                         sw_Ikarus256_a_Volan1_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_Ikarus256_a_Volan1_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_Ikarus256_a_Volan1;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_Ikarus256_a_Volan1_length;
   }
}
