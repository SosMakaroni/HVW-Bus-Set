spriteset(ss_Alfa_Civis_12_a_CC1, "src/Volvo/Alfa_Civis_12_a_CC1_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_Alfa_Civis_12_a_CC1, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Volvo/Alfa_Civis_12_a_CC1_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_Alfa_Civis_12_a_CC1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Volvo/Alfa_Civis_12_a_CC1_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Alfa_Civis_12_a_CC1, position_in_consist ) {
	1: ss_Alfa_Civis_12_a_CC1;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Alfa_Civis_12_a_CC1_articulated, extra_callback_info1) {
	0: item_Alfa_Civis_12_a_CC1;
	1: item_Alfa_Civis_12_a_CC1_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Alfa_Civis_12_a_CC1_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Alfa_Civis_12_a_CC1_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Alfa_Civis_12_a_CC1_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Alfa_Civis_12_a_CC1_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Alfa_Civis_12_a_CC1_INFO); // Jármű infóban név
	0x20: sw_Alfa_Civis_12_a_CC1_names; // Vásárlási lista név
	0x21: return string(STR_Alfa_Civis_12_a_CC1_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Alfa_Civis_12_a_CC1) {
    property {
        name:                          string(STR_Alfa_Civis_12_a_CC1_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2009,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 42;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    70 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         228 kW;
        weight:                        12 ton;
        cargo_capacity:                101;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        // variant_group:                   item_Alfa_Civis_12_a_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_Alfa_Civis_12_a_CC1) {
    property {
         badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
    }
  }
}
item(FEAT_ROADVEHS, item_Alfa_Civis_12_a_CC1) {
    graphics {
        default:                       sw_Alfa_Civis_12_a_CC1;
        
        purchase:                      ss_Alfa_Civis_12_a_CC1_purchase;
        articulated_part:             sw_Alfa_Civis_12_a_CC1_articulated;
        length:                       sw_Alfa_Civis_12_a_CC1_length;
        cost_factor:                  25 * parapuco;
        running_cost_factor:          36 * pararuco;
        additional_text:              string(STR_Alfa_Civis_12_a_CC1_DATA);
        name:                         sw_Alfa_Civis_12_a_CC1_texts;
    }
