// Item
item(FEAT_ROADVEHS, item_Alfa_Civis_12_a_CC1) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_ALFA), string(STR_T1_CIVIS), string(STR_EMPTY), string(STR_EMPTY));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2009,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       42;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               70 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               228 kW;
		weight:              12 ton;
		cargo_capacity:      101;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
		// variant_group:             item_Alfa_Civis_12_a_CC1;
	}
	graphics {
		default:             sw_Alfa_Civis_12_a_CC1;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_Alfa_Civis_12_a_CC1_purchase;
		articulated_part:    sw_Alfa_Civis_12_a_CC1_articulated;
		length:              sw_Alfa_Civis_12_a_CC1_length;
		cost_factor:         25 * parapuco;
		running_cost_factor: 36 * pararuco;
		additional_text:     string(STR_GEN_DATA, 42, string(STR_EMPTY), string(STR_O2_VOLVO_B9L_12M), string(STR_O1_3_DOORS));
		name:                sw_Alfa_Civis_12_a_CC1_texts; // Vásárlási almenü switch
	}
}
// Csukló item
item(FEAT_ROADVEHS, item_Alfa_Civis_12_a_CC1_t) {
	property {
		name:							string(STR_BUG);
		climates_available:			bitmask(NO_CLIMATE);
		introduction_date:				date(4999999,01,01);
		cargo_allow_refit:				[PASS,TOUR];
		loading_speed:					0;
		cost_factor:					0;
		running_cost_factor:			0;
		sprite_id:						SPRITE_ID_NEW_ROADVEH;
		misc_flags:					bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:					0;
		running_cost_base:				RUNNING_COST_NONE;
		power:							0 kW;
		weight:						0 ton;
		cargo_capacity:				0;
		cargo_age_period:				0;
	}
	graphics {
		default:						sw_Alfa_Civis_12_a_CC1;
		 // Cégszín deaktiválás, ha valós színű jármű
		length:						sw_Alfa_Civis_12_a_CC1_length;
