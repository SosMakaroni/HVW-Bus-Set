// Item
item(FEAT_ROADVEHS, item_Ikarus211_b_CC2) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_IKARUS), string(STR_T1_211), string(STR_EMPTY), string(STR_EMPTY));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(1978,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       10;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               80 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               91 kW;
		weight:              7 ton;
		cargo_capacity:      30;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
		variant_group:             item_Ikarus211_b_CC1;
	}
	graphics {
		default:             sw_Ikarus211_b_CC2;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_Ikarus211_b_CC2_purchase;
		articulated_part:    sw_Ikarus211_b_CC2_articulated;
		length:              sw_Ikarus211_b_CC2_length;
		cost_factor:         10 * parapuco;
		running_cost_factor: 14 * pararuco;
		additional_text:     string(STR_GEN_DATA, 10, string(STR_EMPTY), string(STR_O2_8_5M), string(STR_O1_2_DOORS));
		name:                sw_Ikarus211_b_CC2_texts; // Vásárlási almenü switch
	}
}
