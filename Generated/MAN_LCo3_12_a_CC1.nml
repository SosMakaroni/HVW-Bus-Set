// ---------- MAN_LCo3_12_a_CC1

spriteset(ss_MAN_LCo3_12_a_CC1_purchase, "src/MAN/LionsCoach/MAN_LCo3_12_a_CC1_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_MAN_LCo3_12_a_CC1, "src/MAN/LionsCoach/MAN_LCo3_12_a_CC1_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_MAN_LCo3_12_a_CC1, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MAN/LionsCoach/MAN_LCo3_12_a_CC1_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_MAN_LCo3_12_a_CC1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MAN/LionsCoach/MAN_LCo3_12_a_CC1_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MAN_LCo3_12_a_CC1, position_in_consist ) {
	1: ss_MAN_LCo3_12_a_CC1;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MAN_LCo3_12_a_CC1_articulated, extra_callback_info1) {
	0: item_MAN_LCo3_12_a_CC1;
	1: item_MAN_LCo3_12_a_CC1_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MAN_LCo3_12_a_CC1_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MAN_LCo3_12_a_CC1_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_MAN_LCo3_12_a_CC1_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MAN_LCo3_12_a_CC1_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_MAN_LCo3_12_a_CC1_INFO); // Jármű infóban név
	0x20: sw_MAN_LCo3_12_a_CC1_names; // Vásárlási lista név
	0x21: return string(STR_MAN_LCo3_12_a_CC1_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MAN_LCo3_12_a_CC1) {
    property {
        name:                          string(STR_MAN_LCo3_12_a_CC1_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2017,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 10;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    110 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         324 kW;
        weight:                        14 ton;
        cargo_capacity:                49;
        cargo_age_period:              150;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        // variant_group:                   item_MAN_LCo3_12_a_CC1;
        badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/intercity"];
    }
    graphics {
        default:                       sw_MAN_LCo3_12_a_CC1;
        
        purchase:                      ss_MAN_LCo3_12_a_CC1_purchase;
        articulated_part:             sw_MAN_LCo3_12_a_CC1_articulated;
        length:                       sw_MAN_LCo3_12_a_CC1_length;
        cost_factor:                  30 * parapuco;
        running_cost_factor:          47 * pararuco;
        additional_text:              string(STR_MAN_LCo3_12_a_CC1_DATA);
        name:                         sw_MAN_LCo3_12_a_CC1_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_MAN_LCo3_12_a_CC1_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_MAN_LCo3_12_a_CC1;
      
      length:							sw_MAN_LCo3_12_a_CC1_length;
   }
}
// ---------- MAN_LCo3_12_a_CC1 --- End

