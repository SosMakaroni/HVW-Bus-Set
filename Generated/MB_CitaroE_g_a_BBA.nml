// ---------- MB_CitaroE_g_a_BBA

spriteset(ss_MB_CitaroE_g_a_BBA_purchase, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_8bpp.png")		{tmpl25_purchase()}

spriteset(ss_MB_CitaroE_g_a_BBA_a, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_a_8bpp.png")		{tmpl11_1()}
alternative_sprites(ss_MB_CitaroE_g_a_BBA_a, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_a_8bpp.png") {tmpl11_2()}
alternative_sprites(ss_MB_CitaroE_g_a_BBA_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_a_8bpp.png") {tmpl11_4()}

spriteset(ss_MB_CitaroE_g_a_BBA_b, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_b_8bpp.png")		{tmpl8_1()}
alternative_sprites(ss_MB_CitaroE_g_a_BBA_b, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_b_8bpp.png") {tmpl8_2()}
alternative_sprites(ss_MB_CitaroE_g_a_BBA_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_g_a_BBA_b_8bpp.png") {tmpl8_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_g_a_BBA, position_in_consist ) {
	1: ss_MB_CitaroE_g_a_BBA_a;
	2: ss_MB_CitaroE_g_a_BBA_b;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_g_a_BBA_articulated, extra_callback_info1) {
	0: item_MB_CitaroE_g_a_BBA;
	1: item_MB_CitaroE_g_a_BBA_t;
	2: item_MB_CitaroE_g_a_BBA_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_g_a_BBA_length, position_in_consist) {
	1: return 8;
	2: return 8;
    return 3;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_CitaroE_g_a_BBA_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_MB_CitaroE_g_a_BBA_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_CitaroE_g_a_BBA_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_MB_CitaroE_g_a_BBA_INFO); // Jármű infóban név
	0x20: sw_MB_CitaroE_g_a_BBA_names; // Vásárlási lista név
	0x21: return string(STR_MB_CitaroE_g_a_BBA_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MB_CitaroE_g_a_BBA) {
    property {
        name:                          string(STR_MB_CitaroE_g_a_BBA_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2020,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 56;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    80 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         250 kW;
        weight:                        20 ton;
        cargo_capacity:                146;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_MB_CitaroE_g_a_CC1;
        badges:                        ["type/bus", "power/battery", "flag/CH", "usage/city"];
    }
    graphics {
        default:                       sw_MB_CitaroE_g_a_BBA;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_MB_CitaroE_g_a_BBA_purchase;
        articulated_part:             sw_MB_CitaroE_g_a_BBA_articulated;
        length:                       sw_MB_CitaroE_g_a_BBA_length;
        cost_factor:                  44 * parapuco;
        running_cost_factor:          22 * pararuco;
        additional_text:              string(STR_MB_CitaroE_g_a_BBA_DATA);
        name:                         sw_MB_CitaroE_g_a_BBA_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_MB_CitaroE_g_a_BBA_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_MB_CitaroE_g_a_BBA;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_MB_CitaroE_g_a_BBA_length;
   }
}
// ---------- MB_CitaroE_g_a_BBA --- End

