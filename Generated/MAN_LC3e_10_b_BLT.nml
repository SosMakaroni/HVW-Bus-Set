// ---------- MAN_LC3e_10_b_BLT

spriteset(ss_MAN_LC3e_10_b_BLT_purchase, "src/MAN/LionsCity3/MAN_LC3e_10_b_BLT_8bpp.png")		{tmpl11_purchase()}

spriteset(ss_MAN_LC3e_10_b_BLT, "src/MAN/LionsCity3/MAN_LC3e_10_b_BLT_8bpp.png")		{tmpl11_1()}
alternative_sprites(ss_MAN_LC3e_10_b_BLT, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MAN/LionsCity3/MAN_LC3e_10_b_BLT_8bpp.png") {tmpl11_2()}
alternative_sprites(ss_MAN_LC3e_10_b_BLT, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MAN/LionsCity3/MAN_LC3e_10_b_BLT_8bpp.png") {tmpl11_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MAN_LC3e_10_b_BLT, position_in_consist ) {
	1: ss_MAN_LC3e_10_b_BLT;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MAN_LC3e_10_b_BLT_articulated, extra_callback_info1) {
	0: item_MAN_LC3e_10_b_BLT;
	1: item_MAN_LC3e_10_b_BLT_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MAN_LC3e_10_b_BLT_length, position_in_consist) {
	1: return 8;
    return 3;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MAN_LC3e_10_b_BLT_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_MAN_LC3e_10_b_BLT_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MAN_LC3e_10_b_BLT_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_MAN_LC3e_10_b_BLT_INFO); // Jármű infóban név
	0x20: sw_MAN_LC3e_10_b_BLT_names; // Vásárlási lista név
	0x21: return string(STR_MAN_LC3e_10_b_BLT_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MAN_LC3e_10_b_BLT) {
    property {
        name:                          string(STR_MAN_LC3e_10_b_BLT_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2023,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 28;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    80 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         240 kW;
        weight:                        11 ton;
        cargo_capacity:                90;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_MAN_LC3e_10_b_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_MAN_LC3e_10_b_BLT) {
    property {
         badges:                        ["type/bus", "power/battery", "flag/CH", "usage/city"];
    }
  }
}
item(FEAT_ROADVEHS, item_MAN_LC3e_10_b_BLT) {
    graphics {
        default:                       sw_MAN_LC3e_10_b_BLT;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_MAN_LC3e_10_b_BLT_purchase;
        articulated_part:             sw_MAN_LC3e_10_b_BLT_articulated;
        length:                       sw_MAN_LC3e_10_b_BLT_length;
        cost_factor:                  35 * parapuco;
        running_cost_factor:          19 * pararuco;
        additional_text:              string(STR_MAN_LC3e_10_b_BLT_DATA);
        name:                         sw_MAN_LC3e_10_b_BLT_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_MAN_LC3e_10_b_BLT_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_MAN_LC3e_10_b_BLT;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_MAN_LC3e_10_b_BLT_length;
   }
}
// ---------- MAN_LC3e_10_b_BLT --- End

