// ---------- MB_CitaroE_c_a_BLT_new

spriteset(ss_MB_CitaroE_c_a_BLT_new_purchase, "src/MB/Citaro2/MB_CitaroE_c_a_BLT_new_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_MB_CitaroE_c_a_BLT_new, "src/MB/Citaro2/MB_CitaroE_c_a_BLT_new_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_MB_CitaroE_c_a_BLT_new, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_c_a_BLT_new_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_MB_CitaroE_c_a_BLT_new, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_c_a_BLT_new_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_BLT_new, position_in_consist ) {
	1: ss_MB_CitaroE_c_a_BLT_new;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_BLT_new_articulated, extra_callback_info1) {
	0: item_MB_CitaroE_c_a_BLT_new;
	1: item_MB_CitaroE_c_a_BLT_new_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_BLT_new_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_BLT_new_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_MB_CitaroE_c_a_BLT_new_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_BLT_new_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_MB_CitaroE_c_a_BLT_new_INFO); // Jármű infóban név
	0x20: sw_MB_CitaroE_c_a_BLT_new_names; // Vásárlási lista név
	0x21: return string(STR_MB_CitaroE_c_a_BLT_new_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MB_CitaroE_c_a_BLT_new) {
    property {
        name:                          string(STR_MB_CitaroE_c_a_BLT_new_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2018,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 42;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    80 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         250 kW;
        weight:                        13 ton;
        cargo_capacity:                88;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_MB_CitaroE_c_a_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_MB_CitaroE_c_a_BLT_new) {
    property {
         badges:                        ["type/bus", "power/battery", "flag/CH", "usage/city"];
    }
  }
}
item(FEAT_ROADVEHS, item_MB_CitaroE_c_a_BLT_new) {
    graphics {
        default:                       sw_MB_CitaroE_c_a_BLT_new;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_MB_CitaroE_c_a_BLT_new_purchase;
        articulated_part:             sw_MB_CitaroE_c_a_BLT_new_articulated;
        length:                       sw_MB_CitaroE_c_a_BLT_new_length;
        cost_factor:                  38 * parapuco;
        running_cost_factor:          21 * pararuco;
        additional_text:              string(STR_MB_CitaroE_c_a_BLT_new_DATA);
        name:                         sw_MB_CitaroE_c_a_BLT_new_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_MB_CitaroE_c_a_BLT_new_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_MB_CitaroE_c_a_BLT_new;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_MB_CitaroE_c_a_BLT_new_length;
   }
}
