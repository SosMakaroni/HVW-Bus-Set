// ---------- MB_Citaro2_g_ngt_a_CC2

spriteset(ss_MB_Citaro2_g_ngt_a_CC2_purchase, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_8bpp.png")		{tmpl25_purchase()}

spriteset(ss_MB_Citaro2_g_ngt_a_CC2_a, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_a_8bpp.png")		{tmpl11_1()}
alternative_sprites(ss_MB_Citaro2_g_ngt_a_CC2_a, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_a_8bpp.png") {tmpl11_2()}
alternative_sprites(ss_MB_Citaro2_g_ngt_a_CC2_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_a_8bpp.png") {tmpl11_4()}

spriteset(ss_MB_Citaro2_g_ngt_a_CC2_b, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_b_8bpp.png")		{tmpl8_1()}
alternative_sprites(ss_MB_Citaro2_g_ngt_a_CC2_b, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_b_8bpp.png") {tmpl8_2()}
alternative_sprites(ss_MB_Citaro2_g_ngt_a_CC2_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_g_ngt_a_CC2_b_8bpp.png") {tmpl8_4()}

// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_ngt_a_CC2, position_in_consist ) {
	1: ss_MB_Citaro2_g_ngt_a_CC2_a;
	2: ss_MB_Citaro2_g_ngt_a_CC2_b;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_ngt_a_CC2_articulated, extra_callback_info1) {
	0: item_MB_Citaro2_g_ngt_a_CC2;
	1: item_MB_Citaro2_g_ngt_a_CC2_t;
	2: item_MB_Citaro2_g_ngt_a_CC2_t;
	CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_ngt_a_CC2_length, position_in_consist) {
	1: return 8;
	2: return 8;
    return 3;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_ngt_a_CC2_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_GEN_LIVERY, string(STR_LIV_CC2)); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_g_ngt_a_CC2_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_GEN_INFO, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_O1_4_DOORS)); // Jármű infóban név (Gyártó-Típus-Ajtó)
	0x20: sw_MB_Citaro2_g_ngt_a_CC2_names; // Vásárlási lista név
	0x21: return string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_S1_C2), string(STR_S2_G)); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MB_Citaro2_g_ngt_a_CC2) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_S1_C2), string(STR_S2_G));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2014,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       56;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               80 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               220 kW;
		weight:              19 ton;
		cargo_capacity:      163;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/naturgas", "flag/flag_CC", "usage/city"];
		variant_group:             item_MB_Citaro2_g_ngt_a_CC1;
	}
	graphics {
		default:             sw_MB_Citaro2_g_ngt_a_CC2;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_MB_Citaro2_g_ngt_a_CC2_purchase;
		articulated_part:    sw_MB_Citaro2_g_ngt_a_CC2_articulated;
		length:              sw_MB_Citaro2_g_ngt_a_CC2_length;
		cost_factor:         33 * parapuco;
		running_cost_factor: 30 * pararuco;
		additional_text:     string(STR_GEN_DATA, 56, string(STR_S2_G), string(STR_O2_18M), string(STR_O1_4_DOORS));
		name:                sw_MB_Citaro2_g_ngt_a_CC2_texts; // Vásárlási almenü switch
	}
}
// Csukló item
item(FEAT_ROADVEHS, item_MB_Citaro2_g_ngt_a_CC2_t) {
	property {
		name:							string(STR_BUG);
		climates_available:			bitmask(NO_CLIMATE);
		introduction_date:				date(4999999,01,01);
		cargo_allow_refit:				[PASS,TOUR];
		loading_speed:					0;
		cost_factor:					0;
		running_cost_factor:			0;
		sprite_id:						SPRITE_ID_NEW_ROADVEH;
		misc_flags:					bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:					0;
		running_cost_base:				RUNNING_COST_NONE;
		power:							0 kW;
		weight:						0 ton;
		cargo_capacity:				0;
		cargo_age_period:				0;
	}
	graphics {
		default:						sw_MB_Citaro2_g_ngt_a_CC2;
		 // Cégszín deaktiválás, ha valós színű jármű
		length:						sw_MB_Citaro2_g_ngt_a_CC2_length;
	}
}
// ---------- MB_Citaro2_g_ngt_a_CC2 --- End

