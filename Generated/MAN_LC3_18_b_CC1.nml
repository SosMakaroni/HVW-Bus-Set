// ---------- MAN_LC3_18_b_CC1

spriteset(ss_MAN_LC3_18_b_CC1_purchase, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_8bpp.png")		{tmpl25_purchase()}

spriteset(ss_MAN_LC3_18_b_CC1_a, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_a_8bpp.png")		{tmpl10_1()}
alternative_sprites(ss_MAN_LC3_18_b_CC1_a, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_a_8bpp.png") {tmpl10_2()}
alternative_sprites(ss_MAN_LC3_18_b_CC1_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_a_8bpp.png") {tmpl10_4()}

spriteset(ss_MAN_LC3_18_b_CC1_b, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_b_8bpp.png")		{tmpl9_1()}
alternative_sprites(ss_MAN_LC3_18_b_CC1_b, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_b_8bpp.png") {tmpl9_2()}
alternative_sprites(ss_MAN_LC3_18_b_CC1_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MAN/LionsCity3/MAN_LC3_18_b_CC1_b_8bpp.png") {tmpl9_4()}

// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MAN_LC3_18_b_CC1, position_in_consist ) {
	1: ss_MAN_LC3_18_b_CC1_a;
	2: ss_toldat;
	3: ss_MAN_LC3_18_b_CC1_b;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MAN_LC3_18_b_CC1_articulated, extra_callback_info1) {
	0: item_MAN_LC3_18_b_CC1;
	1: item_MAN_LC3_18_b_CC1_t;
	2: item_MAN_LC3_18_b_CC1_t;
	3: item_MAN_LC3_18_b_CC1_t;
	CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MAN_LC3_18_b_CC1_length, position_in_consist) {
	1: return 8;
	2: return 1;
	3: return 8;
    return 2;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MAN_LC3_18_b_CC1_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_GEN_LIVERY, string(STR_LIV_CC_TWO_TONE)); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MAN_LC3_18_b_CC1_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_GEN_INFO, string(STR_MFR_MAN), string(STR_T1_LION_S_CITY), string(STR_O1_3_DOORS)); // Jármű infóban név (Gyártó-Típus-Ajtó)
	0x20: sw_MAN_LC3_18_b_CC1_names; // Vásárlási lista név
	0x21: return string(STR_GEN_NAME, string(STR_MFR_MAN), string(STR_T1_LION_S_CITY), string(STR_S1_3), string(STR_S2_18C)); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MAN_LC3_18_b_CC1) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_MAN), string(STR_T1_LION_S_CITY), string(STR_S1_3), string(STR_S2_18C));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2017,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       42;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               80 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               265 kW;
		weight:              17 ton;
		cargo_capacity:      171;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
		// variant_group:             item_MAN_LC3_18_b_CC1;
	}
	graphics {
		default:             sw_MAN_LC3_18_b_CC1;
		    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_MAN_LC3_18_b_CC1_purchase;
		articulated_part:    sw_MAN_LC3_18_b_CC1_articulated;
		length:              sw_MAN_LC3_18_b_CC1_length;
		cost_factor:         30 * parapuco;
		running_cost_factor: 42 * pararuco;
		additional_text:     string(STR_GEN_DATA, 42, string(STR_S2_18C), string(STR_O2_18M), string(STR_O1_3_DOORS));
		name:                sw_MAN_LC3_18_b_CC1_texts; // Vásárlási almenü switch
	}
}
// Csukló item
item(FEAT_ROADVEHS, item_MAN_LC3_18_b_CC1_t) {
	property {
		name:							string(STR_BUG);
		climates_available:			bitmask(NO_CLIMATE);
		introduction_date:				date(4999999,01,01);
		cargo_allow_refit:				[PASS,TOUR];
		loading_speed:					0;
		cost_factor:					0;
		running_cost_factor:			0;
		sprite_id:						SPRITE_ID_NEW_ROADVEH;
		misc_flags:					bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:					0;
		running_cost_base:				RUNNING_COST_NONE;
		power:							0 kW;
		weight:						0 ton;
		cargo_capacity:				0;
		cargo_age_period:				0;
	}
	graphics {
		default:						sw_MAN_LC3_18_b_CC1;
		 // Cégszín deaktiválás, ha valós színű jármű
		length:						sw_MAN_LC3_18_b_CC1_length;
	}
}
// ---------- MAN_LC3_18_b_CC1 --- End

