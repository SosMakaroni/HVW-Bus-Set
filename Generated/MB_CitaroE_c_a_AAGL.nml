// ---------- MB_CitaroE_c_a_AAGL

spriteset(ss_MB_CitaroE_c_a_AAGL_purchase, "src/MB/Citaro2/MB_CitaroE_c_a_AAGL_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_MB_CitaroE_c_a_AAGL, "src/MB/Citaro2/MB_CitaroE_c_a_AAGL_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_MB_CitaroE_c_a_AAGL, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_c_a_AAGL_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_MB_CitaroE_c_a_AAGL, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_CitaroE_c_a_AAGL_8bpp.png") {tmpl13_4()}

// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_AAGL, position_in_consist ) {
	1: ss_MB_CitaroE_c_a_AAGL;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_AAGL_articulated, extra_callback_info1) {
	0: item_MB_CitaroE_c_a_AAGL;
	1: item_MB_CitaroE_c_a_AAGL_t;
	CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_AAGL_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_AAGL_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_GEN_LIVERY, string(STR_LIV_AAGL)); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_CitaroE_c_a_AAGL_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_GEN_INFO, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_O1_3_DOORS)); // Jármű infóban név (Gyártó-Típus-Ajtó)
	0x20: sw_MB_CitaroE_c_a_AAGL_names; // Vásárlási lista név
	0x21: return string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_S1_C2), string(STR_EMPTY)); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MB_CitaroE_c_a_AAGL) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_MERCEDES_BENZ), string(STR_T1_CITARO), string(STR_S1_C2), string(STR_EMPTY));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(2018,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       42;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               80 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               250 kW;
		weight:              13 ton;
		cargo_capacity:      88;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/battery", "flag/CH", "usage/city"];
		variant_group:             item_MB_CitaroE_c_a_CC1;
	}
	graphics {
		default:             sw_MB_CitaroE_c_a_AAGL;
		colour_mapping:	PALETTE_IDENTITY;    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_MB_CitaroE_c_a_AAGL_purchase;
		articulated_part:    sw_MB_CitaroE_c_a_AAGL_articulated;
		length:              sw_MB_CitaroE_c_a_AAGL_length;
		cost_factor:         38 * parapuco;
		running_cost_factor: 21 * pararuco;
		additional_text:     string(STR_GEN_DATA, 42, string(STR_EMPTY), string(STR_O2_12M), string(STR_O1_3_DOORS));
		name:                sw_MB_CitaroE_c_a_AAGL_texts; // Vásárlási almenü switch
	}
}
// Csukló item
item(FEAT_ROADVEHS, item_MB_CitaroE_c_a_AAGL_t) {
	property {
		name:							string(STR_BUG);
		climates_available:			bitmask(NO_CLIMATE);
		introduction_date:				date(4999999,01,01);
		cargo_allow_refit:				[PASS,TOUR];
		loading_speed:					0;
		cost_factor:					0;
		running_cost_factor:			0;
		sprite_id:						SPRITE_ID_NEW_ROADVEH;
		misc_flags:					bitmask(ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:					0;
		running_cost_base:				RUNNING_COST_NONE;
		power:							0 kW;
		weight:						0 ton;
		cargo_capacity:				0;
		cargo_age_period:				0;
	}
	graphics {
		default:						sw_MB_CitaroE_c_a_AAGL;
		colour_mapping:	PALETTE_IDENTITY; // Cégszín deaktiválás, ha valós színű jármű
		length:						sw_MB_CitaroE_c_a_AAGL_length;
	}
}
// ---------- MB_CitaroE_c_a_AAGL --- End

