// ---------- Ikarus30_1_a_CC2

spriteset(ss_Ikarus30_1_a_CC2_purchase, "src/Ikarus/old/Ikarus30_1_a_CC2_8bpp.png")		{tmpl9_purchase()}

spriteset(ss_Ikarus30_1_a_CC2, "src/Ikarus/old/Ikarus30_1_a_CC2_8bpp.png")		{tmpl9_1()}
alternative_sprites(ss_Ikarus30_1_a_CC2, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Ikarus/old/Ikarus30_1_a_CC2_8bpp.png") {tmpl9_2()}
alternative_sprites(ss_Ikarus30_1_a_CC2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Ikarus/old/Ikarus30_1_a_CC2_8bpp.png") {tmpl9_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Ikarus30_1_a_CC2, position_in_consist ) {
	1: ss_Ikarus30_1_a_CC2;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Ikarus30_1_a_CC2_articulated, extra_callback_info1) {
	0: item_Ikarus30_1_a_CC2;
	1: item_Ikarus30_1_a_CC2_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Ikarus30_1_a_CC2_length, position_in_consist) {
	1: return 8;
    return 1;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Ikarus30_1_a_CC2_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Ikarus30_1_a_CC2_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Ikarus30_1_a_CC2_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Ikarus30_1_a_CC2_INFO); // Jármű infóban név
	0x20: sw_Ikarus30_1_a_CC2_names; // Vásárlási lista név
	0x21: return string(STR_Ikarus30_1_a_CC2_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Ikarus30_1_a_CC2) {
    property {
        name:                          string(STR_Ikarus30_1_a_CC2_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(1951,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 5;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    75 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         62 kW;
        weight:                        4 ton;
        cargo_capacity:                30;
        cargo_age_period:              150;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_Ikarus30_1_a_CC1;
        badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/intercity"];
    }
    graphics {
        default:                       sw_Ikarus30_1_a_CC2;
        
        purchase:                      ss_Ikarus30_1_a_CC2_purchase;
        articulated_part:             sw_Ikarus30_1_a_CC2_articulated;
        length:                       sw_Ikarus30_1_a_CC2_length;
        cost_factor:                  7 * parapuco;
        running_cost_factor:          9 * pararuco;
        additional_text:              string(STR_Ikarus30_1_a_CC2_DATA);
        name:                         sw_Ikarus30_1_a_CC2_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_Ikarus30_1_a_CC2_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_Ikarus30_1_a_CC2;
      
      length:							sw_Ikarus30_1_a_CC2_length;
   }
}
// ---------- Ikarus30_1_a_CC2 --- End

