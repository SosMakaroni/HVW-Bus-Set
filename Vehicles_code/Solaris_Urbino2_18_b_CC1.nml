// ---------- Solaris_Urbino2_18_b_CC1

spriteset(ss_Solaris_Urbino2_18_b_CC1_purchase, "src/Solaris/Solaris_Urbino2_18_b_CC1_8bpp.png")		{tmpl25_purchase()}

spriteset(ss_Solaris_Urbino2_18_b_CC1_a, "src/Solaris/Solaris_Urbino2_18_b_CC1_a_8bpp.png")		{tmpl10_1()}
alternative_sprites(ss_Solaris_Urbino2_18_b_CC1_a, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Solaris/Solaris_Urbino2_18_b_CC1_a_8bpp.png") {tmpl10_2()}
alternative_sprites(ss_Solaris_Urbino2_18_b_CC1_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Solaris/Solaris_Urbino2_18_b_CC1_a_8bpp.png") {tmpl10_4()}

spriteset(ss_Solaris_Urbino2_18_b_CC1_b, "src/Solaris/Solaris_Urbino2_18_b_CC1_b_8bpp.png")		{tmpl9_1()}
alternative_sprites(ss_Solaris_Urbino2_18_b_CC1_b, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Solaris/Solaris_Urbino2_18_b_CC1_b_8bpp.png") {tmpl9_2()}
alternative_sprites(ss_Solaris_Urbino2_18_b_CC1_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Solaris/Solaris_Urbino2_18_b_CC1_b_8bpp.png") {tmpl9_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Solaris_Urbino2_18_b_CC1, position_in_consist ) {
	1: ss_Solaris_Urbino2_18_b_CC1_a;
	2: ss_toldat;
	3: ss_Solaris_Urbino2_18_b_CC1_b;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Solaris_Urbino2_18_b_CC1_articulated, extra_callback_info1) {
	0: item_Solaris_Urbino2_18_b_CC1;
	1: item_Solaris_Urbino2_18_b_CC1_t;
	2: item_Solaris_Urbino2_18_b_CC1_t;
	3: item_Solaris_Urbino2_18_b_CC1_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Solaris_Urbino2_18_b_CC1_length, position_in_consist) {
	1: return 8;
	2: return 1;
	3: return 8;
    return 2;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Solaris_Urbino2_18_b_CC1_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Solaris_Urbino2_18_b_CC1_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Solaris_Urbino2_18_b_CC1_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Solaris_Urbino2_18_b_CC1_INFO); // Jármű infóban név
	0x20: sw_Solaris_Urbino2_18_b_CC1_names; // Vásárlási lista név
	0x21: return string(STR_Solaris_Urbino2_18_b_CC1_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Solaris_Urbino2_18_b_CC1) {
    property {
        name:                          string(STR_Solaris_Urbino2_18_b_CC1_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2002,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 42;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    70 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         240 kW;
        weight:                        17 ton;
        cargo_capacity:                145;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        // variant_group:                   item_Solaris_Urbino2_18_b_CC1;
        badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
    }
    graphics {
        default:                       sw_Solaris_Urbino2_18_b_CC1;
        
        purchase:                      ss_Solaris_Urbino2_18_b_CC1_purchase;
        articulated_part:             sw_Solaris_Urbino2_18_b_CC1_articulated;
        length:                       sw_Solaris_Urbino2_18_b_CC1_length;
        cost_factor:                  28 * parapuco;
        running_cost_factor:          38 * pararuco;
        additional_text:              string(STR_Solaris_Urbino2_18_b_CC1_DATA);
        name:                         sw_Solaris_Urbino2_18_b_CC1_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_Solaris_Urbino2_18_b_CC1_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_Solaris_Urbino2_18_b_CC1;
      
      length:							sw_Solaris_Urbino2_18_b_CC1_length;
   }
}
