// ---------- Ikarus280_a_Volan

spriteset(ss_Ikarus280_a_Volan_purchase, "src/Ikarus/2xx/Ikarus280_a_Volan_8bpp.png")		{tmpl25_purchase()}

spriteset(ss_Ikarus280_a_Volan_a, "src/Ikarus/2xx/Ikarus280_a_Volan_a_8bpp.png")		{tmpl10_1()}
alternative_sprites(ss_Ikarus280_a_Volan_a, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Ikarus/2xx/Ikarus280_a_Volan_a_8bpp.png") {tmpl10_2()}
alternative_sprites(ss_Ikarus280_a_Volan_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Ikarus/2xx/Ikarus280_a_Volan_a_8bpp.png") {tmpl10_4()}

spriteset(ss_Ikarus280_a_Volan_b, "src/Ikarus/2xx/Ikarus280_a_Volan_b_8bpp.png")		{tmpl7_1()}
alternative_sprites(ss_Ikarus280_a_Volan_b, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Ikarus/2xx/Ikarus280_a_Volan_b_8bpp.png") {tmpl7_2()}
alternative_sprites(ss_Ikarus280_a_Volan_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Ikarus/2xx/Ikarus280_a_Volan_b_8bpp.png") {tmpl7_4()}

// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Ikarus280_a_Volan, position_in_consist ) {
	1: ss_Ikarus280_a_Volan_a;
	2: ss_Ikarus280_a_Volan_b;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Ikarus280_a_Volan_articulated, extra_callback_info1) {
	0: item_Ikarus280_a_Volan;
	1: item_Ikarus280_a_Volan_t;
	2: item_Ikarus280_a_Volan_t;
	CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Ikarus280_a_Volan_length, position_in_consist) {
	1: return 8;
	2: return 7;
    return 2;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Ikarus280_a_Volan_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_GEN_LIVERY, string(STR_LIV_VOLAN)); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Ikarus280_a_Volan_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_GEN_INFO, string(STR_MFR_IKARUS), string(STR_T1_280), string(STR_O1_4_DOORS)); // Jármű infóban név (Gyártó-Típus-Ajtó)
	0x20: sw_Ikarus280_a_Volan_names; // Vásárlási lista név
	0x21: return string(STR_GEN_NAME, string(STR_MFR_IKARUS), string(STR_T1_280), string(STR_EMPTY), string(STR_EMPTY)); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Ikarus280_a_Volan) {
	property {
		name:                string(STR_GEN_NAME, string(STR_MFR_IKARUS), string(STR_T1_280), string(STR_EMPTY), string(STR_EMPTY));
		climates_available:  bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
		introduction_date:   date(1973,01,01);
		model_life:          20;
		vehicle_life:        25;
		reliability_decay:   20;
		cargo_allow_refit:   [PASS,TOUR];
		loading_speed:       40;
		sprite_id:           SPRITE_ID_NEW_ROADVEH;
		speed:               70 km/h;
		misc_flags:          bitmask(ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:          0;
		running_cost_base:   RUNNING_COST_ROADVEH;
		power:               141 kW;
		weight:              12 ton;
		cargo_capacity:      147;
		cargo_age_period:    200;
		sound_effect:        SOUND_DEPARTURE_MODERN_BUS;
		badges:              ["type/bus", "power/diesel", "flag/HU", "usage/city"];
		variant_group:             item_Ikarus280_a_CC1;
	}
	graphics {
		default:             sw_Ikarus280_a_Volan;
		colour_mapping:	PALETTE_IDENTITY;    // Cégszín deaktiválás, ha valós színű jármű
		purchase:            ss_Ikarus280_a_Volan_purchase;
		articulated_part:    sw_Ikarus280_a_Volan_articulated;
		length:              sw_Ikarus280_a_Volan_length;
		cost_factor:         18 * parapuco;
		running_cost_factor: 24 * pararuco;
		additional_text:     string(STR_GEN_DATA, 40, string(STR_EMPTY), string(STR_O2_17M), string(STR_O1_4_DOORS));
		name:                sw_Ikarus280_a_Volan_texts; // Vásárlási almenü switch
	}
}
// Csukló item
item(FEAT_ROADVEHS, item_Ikarus280_a_Volan_t) {
	property {
		name:							string(STR_BUG);
		climates_available:			bitmask(NO_CLIMATE);
		introduction_date:				date(4999999,01,01);
		cargo_allow_refit:				[PASS,TOUR];
		loading_speed:					0;
		cost_factor:					0;
		running_cost_factor:			0;
		sprite_id:						SPRITE_ID_NEW_ROADVEH;
		misc_flags:					bitmask(ROADVEH_FLAG_SPRITE_STACK);
		refit_cost:					0;
		running_cost_base:				RUNNING_COST_NONE;
		power:							0 kW;
		weight:						0 ton;
		cargo_capacity:				0;
		cargo_age_period:				0;
	}
	graphics {
		default:						sw_Ikarus280_a_Volan;
		colour_mapping:	PALETTE_IDENTITY; // Cégszín deaktiválás, ha valós színű jármű
		length:						sw_Ikarus280_a_Volan_length;
	}
}
// ---------- Ikarus280_a_Volan --- End

