// ---------- Ikarus260_b_Kisalfold

spriteset(ss_Ikarus260_b_Kisalfold_purchase, "src/Ikarus/2xx/Ikarus260_b_Kisalfold_8bpp.png")		{tmpl12_purchase()}

spriteset(ss_Ikarus260_b_Kisalfold, "src/Ikarus/2xx/Ikarus260_b_Kisalfold_8bpp.png")		{tmpl12_1()}
alternative_sprites(ss_Ikarus260_b_Kisalfold, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Ikarus/2xx/Ikarus260_b_Kisalfold_8bpp.png") {tmpl12_2()}
alternative_sprites(ss_Ikarus260_b_Kisalfold, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Ikarus/2xx/Ikarus260_b_Kisalfold_8bpp.png") {tmpl12_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Ikarus260_b_Kisalfold, position_in_consist ) {
	1: ss_Ikarus260_b_Kisalfold;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Ikarus260_b_Kisalfold_articulated, extra_callback_info1) {
	0: item_Ikarus260_b_Kisalfold;
	1: item_Ikarus260_b_Kisalfold_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Ikarus260_b_Kisalfold_length, position_in_consist) {
	1: return 8;
    return 4;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Ikarus260_b_Kisalfold_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Ikarus260_b_Kisalfold_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Ikarus260_b_Kisalfold_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Ikarus260_b_Kisalfold_INFO); // Jármű infóban név
	0x20: sw_Ikarus260_b_Kisalfold_names; // Vásárlási lista név
	0x21: return string(STR_Ikarus260_b_Kisalfold_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Ikarus260_b_Kisalfold) {
    property {
        name:                          string(STR_Ikarus260_b_Kisalfold_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(1996,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 20;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    70 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         162 kW;
        weight:                        9 ton;
        cargo_capacity:                98;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_Ikarus260_b_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_Ikarus260_b_Kisalfold) {
    property {
         badges:                        ["type/bus", "power/diesel", "flag/HU", "usage/suburb"];
    }
  }
}
item(FEAT_ROADVEHS, item_Ikarus260_b_Kisalfold) {
    graphics {
        default:                       sw_Ikarus260_b_Kisalfold;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_Ikarus260_b_Kisalfold_purchase;
        articulated_part:             sw_Ikarus260_b_Kisalfold_articulated;
        length:                       sw_Ikarus260_b_Kisalfold_length;
        cost_factor:                  17 * parapuco;
        running_cost_factor:          25 * pararuco;
        additional_text:              string(STR_Ikarus260_b_Kisalfold_DATA);
        name:                         sw_Ikarus260_b_Kisalfold_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_Ikarus260_b_Kisalfold_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_Ikarus260_b_Kisalfold;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_Ikarus260_b_Kisalfold_length;
   }
}
// ---------- Ikarus260_b_Kisalfold --- End

