// ---------- Newflyer_D40LF_a_BCTransit_old

spriteset(ss_Newflyer_D40LF_a_BCTransit_old_purchase, "src/Other/Newflyer_D40LF_a_BCTransit_old_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_Newflyer_D40LF_a_BCTransit_old, "src/Other/Newflyer_D40LF_a_BCTransit_old_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_Newflyer_D40LF_a_BCTransit_old, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Other/Newflyer_D40LF_a_BCTransit_old_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_Newflyer_D40LF_a_BCTransit_old, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Other/Newflyer_D40LF_a_BCTransit_old_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Newflyer_D40LF_a_BCTransit_old, position_in_consist ) {
	1: ss_Newflyer_D40LF_a_BCTransit_old;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Newflyer_D40LF_a_BCTransit_old_articulated, extra_callback_info1) {
	0: item_Newflyer_D40LF_a_BCTransit_old;
	1: item_Newflyer_D40LF_a_BCTransit_old_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Newflyer_D40LF_a_BCTransit_old_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Newflyer_D40LF_a_BCTransit_old_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Newflyer_D40LF_a_BCTransit_old_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Newflyer_D40LF_a_BCTransit_old_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Newflyer_D40LF_a_BCTransit_old_INFO); // Jármű infóban név
	0x20: sw_Newflyer_D40LF_a_BCTransit_old_names; // Vásárlási lista név
	0x21: return string(STR_Newflyer_D40LF_a_BCTransit_old_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Newflyer_D40LF_a_BCTransit_old) {
    property {
        name:                          string(STR_Newflyer_D40LF_a_BCTransit_old_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(1991,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 28;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    70 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         205 kW;
        weight:                        12 ton;
        cargo_capacity:                77;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_Newflyer_D40LF_a_CC1;
        badges:                        ["type/bus", "power/diesel", "flag/CA", "usage/city"];
    }
    graphics {
        default:                       sw_Newflyer_D40LF_a_BCTransit_old;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_Newflyer_D40LF_a_BCTransit_old_purchase;
        articulated_part:             sw_Newflyer_D40LF_a_BCTransit_old_articulated;
        length:                       sw_Newflyer_D40LF_a_BCTransit_old_length;
        cost_factor:                  22 * parapuco;
        running_cost_factor:          32 * pararuco;
        additional_text:              string(STR_Newflyer_D40LF_a_BCTransit_old_DATA);
        name:                         sw_Newflyer_D40LF_a_BCTransit_old_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_Newflyer_D40LF_a_BCTransit_old_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_Newflyer_D40LF_a_BCTransit_old;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_Newflyer_D40LF_a_BCTransit_old_length;
   }
}
// ---------- Newflyer_D40LF_a_BCTransit_old --- End

