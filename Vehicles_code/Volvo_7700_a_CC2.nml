// ---------- Volvo_7700_a_CC2

spriteset(ss_Volvo_7700_a_CC2_purchase, "src/Volvo/Volvo_7700_a_CC2_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_Volvo_7700_a_CC2, "src/Volvo/Volvo_7700_a_CC2_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_Volvo_7700_a_CC2, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Volvo/Volvo_7700_a_CC2_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_Volvo_7700_a_CC2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Volvo/Volvo_7700_a_CC2_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Volvo_7700_a_CC2, position_in_consist ) {
	1: ss_Volvo_7700_a_CC2;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Volvo_7700_a_CC2_articulated, extra_callback_info1) {
	0: item_Volvo_7700_a_CC2;
	1: item_Volvo_7700_a_CC2_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Volvo_7700_a_CC2_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Volvo_7700_a_CC2_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Volvo_7700_a_CC2_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Volvo_7700_a_CC2_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Volvo_7700_a_CC2_INFO); // Jármű infóban név
	0x20: sw_Volvo_7700_a_CC2_names; // Vásárlási lista név
	0x21: return string(STR_Volvo_7700_a_CC2_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Volvo_7700_a_CC2) {
    property {
        name:                          string(STR_Volvo_7700_a_CC2_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(1999,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 42;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    70 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         199 kW;
        weight:                        12 ton;
        cargo_capacity:                90;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_Volvo_7700_a_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_Volvo_7700_a_CC2) {
    property {
         badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
    }
  }
}
item(FEAT_ROADVEHS, item_Volvo_7700_a_CC2) {
    graphics {
        default:                       sw_Volvo_7700_a_CC2;
        
        purchase:                      ss_Volvo_7700_a_CC2_purchase;
        articulated_part:             sw_Volvo_7700_a_CC2_articulated;
        length:                       sw_Volvo_7700_a_CC2_length;
        cost_factor:                  23 * parapuco;
        running_cost_factor:          32 * pararuco;
        additional_text:              string(STR_Volvo_7700_a_CC2_DATA);
        name:                         sw_Volvo_7700_a_CC2_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_Volvo_7700_a_CC2_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_Volvo_7700_a_CC2;
      
      length:							sw_Volvo_7700_a_CC2_length;
   }
}
// ---------- Volvo_7700_a_CC2 --- End

