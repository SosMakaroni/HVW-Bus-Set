// ---------- MB_Citaro2_c_b_Sernftal

spriteset(ss_MB_Citaro2_c_b_Sernftal_purchase, "src/MB/Citaro2/MB_Citaro2_c_b_Sernftal_8bpp.png")		{tmpl13_purchase()}

spriteset(ss_MB_Citaro2_c_b_Sernftal, "src/MB/Citaro2/MB_Citaro2_c_b_Sernftal_8bpp.png")		{tmpl13_1()}
alternative_sprites(ss_MB_Citaro2_c_b_Sernftal, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_c_b_Sernftal_8bpp.png") {tmpl13_2()}
alternative_sprites(ss_MB_Citaro2_c_b_Sernftal, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/MB/Citaro2/MB_Citaro2_c_b_Sernftal_8bpp.png") {tmpl13_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_b_Sernftal, position_in_consist ) {
	1: ss_MB_Citaro2_c_b_Sernftal;
	ss_toldat;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_b_Sernftal_articulated, extra_callback_info1) {
	0: item_MB_Citaro2_c_b_Sernftal;
	1: item_MB_Citaro2_c_b_Sernftal_t;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_b_Sernftal_length, position_in_consist) {
	1: return 8;
    return 5;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_b_Sernftal_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_MB_Citaro2_c_b_Sernftal_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_MB_Citaro2_c_b_Sernftal_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_MB_Citaro2_c_b_Sernftal_INFO); // Jármű infóban név
	0x20: sw_MB_Citaro2_c_b_Sernftal_names; // Vásárlási lista név
	0x21: return string(STR_MB_Citaro2_c_b_Sernftal_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_MB_Citaro2_c_b_Sernftal) {
    property {
        name:                          string(STR_MB_Citaro2_c_b_Sernftal_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(2012,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 28;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    80 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         260 kW;
        weight:                        12 ton;
        cargo_capacity:                106;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        variant_group:                   item_MB_Citaro2_c_b_CC1;
    }
}
if (param[2] == 0) {
 item(FEAT_ROADVEHS, item_MB_Citaro2_c_b_Sernftal) {
    property {
         badges:                        ["type/bus", "power/diesel", "flag/CH", "usage/city"];
    }
  }
}
item(FEAT_ROADVEHS, item_MB_Citaro2_c_b_Sernftal) {
    graphics {
        default:                       sw_MB_Citaro2_c_b_Sernftal;
        colour_mapping:	PALETTE_IDENTITY;
        purchase:                      ss_MB_Citaro2_c_b_Sernftal_purchase;
        articulated_part:             sw_MB_Citaro2_c_b_Sernftal_articulated;
        length:                       sw_MB_Citaro2_c_b_Sernftal_length;
        cost_factor:                  26 * parapuco;
        running_cost_factor:          39 * pararuco;
        additional_text:              string(STR_MB_Citaro2_c_b_Sernftal_DATA);
        name:                         sw_MB_Citaro2_c_b_Sernftal_texts;
    }
}

// Csukló item
item(FEAT_ROADVEHS, item_MB_Citaro2_c_b_Sernftal_t) {
  property {
      name:							string(STR_BUG);
      climates_available:				bitmask(NO_CLIMATE);
      introduction_date:				date(4999999,01,01);
      cargo_allow_refit:				[PASS,TOUR];
      loading_speed:					0;
      cost_factor:					0;
      running_cost_factor:			0;
      sprite_id:						SPRITE_ID_NEW_ROADVEH;
      misc_flags:						bitmask(ROADVEH_FLAG_SPRITE_STACK);
      refit_cost:						0;
      running_cost_base:				RUNNING_COST_NONE;
      power:							0 kW;
      weight:							0 ton;
      cargo_capacity:					0;
      cargo_age_period:				0;
   }
   graphics {
      default:						sw_MB_Citaro2_c_b_Sernftal;
      colour_mapping:	PALETTE_IDENTITY;
      length:							sw_MB_Citaro2_c_b_Sernftal_length;
   }
}
