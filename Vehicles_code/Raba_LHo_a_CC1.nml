// ---------- Raba_LHo_a_CC1

spriteset(ss_Raba_LHo_a_CC1_purchase, "src/Raba/Raba_LHo_a_CC1_8bpp.png")		{tmpl7_purchase()}

spriteset(ss_Raba_LHo_a_CC1, "src/Raba/Raba_LHo_a_CC1_8bpp.png")		{tmpl7_1()}
alternative_sprites(ss_Raba_LHo_a_CC1, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "src/Raba/Raba_LHo_a_CC1_8bpp.png") {tmpl7_2()}
alternative_sprites(ss_Raba_LHo_a_CC1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "src/Raba/Raba_LHo_a_CC1_8bpp.png") {tmpl7_4()}


// Játékban grafika
switch (FEAT_ROADVEHS, SELF, sw_Raba_LHo_a_CC1, position_in_consist ) {
	ss_Raba_LHo_a_CC1;
}

// Csuklosítás
switch (FEAT_ROADVEHS, SELF, sw_Raba_LHo_a_CC1_articulated, extra_callback_info1) {
	0: item_Raba_LHo_a_CC1;
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Modelhossz
switch (FEAT_ROADVEHS, SELF, sw_Raba_LHo_a_CC1_length, position_in_consist) {
    return 7;
}

// Szövegek
switch(FEAT_ROADVEHS, SELF, sw_Raba_LHo_a_CC1_names, (extra_callback_info1 >> 8) & 0xFFFF) {
	1: return string(STR_Raba_LHo_a_CC1_NAME2); // Almenü 1 név
	return CB_RESULT_NO_TEXT;
}

switch(FEAT_ROADVEHS, SELF, sw_Raba_LHo_a_CC1_texts, extra_callback_info1 & 0xFF) {
	0x11: return string(STR_Raba_LHo_a_CC1_INFO); // Jármű infóban név
	0x20: sw_Raba_LHo_a_CC1_names; // Vásárlási lista név
	0x21: return string(STR_Raba_LHo_a_CC1_NAME); // Elővásárlási név
	return CB_RESULT_NO_TEXT;
}

// Item
item(FEAT_ROADVEHS, item_Raba_LHo_a_CC1) {
    property {
        name:                          string(STR_Raba_LHo_a_CC1_NAME);
        climates_available:            bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date:             date(1926,01,01);
        model_life:                    20;
        vehicle_life:                  25;
        reliability_decay:             20;
        cargo_allow_refit:             [PASS,TOUR];
        loading_speed:                 10;
        sprite_id:                     SPRITE_ID_NEW_ROADVEH;
        speed:                    45 km/h;
        misc_flags:                    bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_SPRITE_STACK);
        refit_cost:                    0;
        running_cost_base:             RUNNING_COST_ROADVEH;
        power:                         33 kW;
        weight:                        4 ton;
        cargo_capacity:                34;
        cargo_age_period:              200;
        sound_effect:                  SOUND_DEPARTURE_MODERN_BUS;
        // variant_group:                   item_Raba_LHo_a_CC1;
        badges:                        ["type/bus", "power/diesel", "flag/flag_CC", "usage/city"];
    }
    graphics {
        default:                       sw_Raba_LHo_a_CC1;
        
        purchase:                      ss_Raba_LHo_a_CC1_purchase;
        articulated_part:             sw_Raba_LHo_a_CC1_articulated;
        length:                       sw_Raba_LHo_a_CC1_length;
        cost_factor:                  5 * parapuco;
        running_cost_factor:          8 * pararuco;
        additional_text:              string(STR_Raba_LHo_a_CC1_DATA);
        name:                         sw_Raba_LHo_a_CC1_texts;
    }
}
// ---------- Raba_LHo_a_CC1 --- End

